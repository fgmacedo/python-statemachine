#: statemachine/callbacks.py:409 statemachine/callbacks.py:414
#, python-brace-format
msgid "Did not found name '{}' from model or statemachine"
msgstr "在模型或状态机中未找到名称 '{}'"

#: statemachine/configuration.py:128
msgid ""
"There's no current state set. In async code, did you activate the initial"
" state? (e.g., `await sm.activate_initial_state()`)"
msgstr "没有设置当前状态。在异步代码中，您是否激活了初始状态？（例如，`await sm.activate_initial_state()`）"

#: statemachine/dispatcher.py:127
#, python-brace-format
msgid "Failed to parse boolean expression '{}'"
msgstr "无法解析布尔表达式 '{}'"

#: statemachine/event.py:56
#, python-brace-format
msgid ""
"Event {id!r} cannot be both delayed and internal: the internal queue runs"
" within the current macrostep, which takes no time. Drop 'internal' to "
"deliver it later on the external queue, or drop 'delay' to run it now."
msgstr ""
"事件 {id!r} 不能同时是延迟的和内部的：内部队列在当前宏步骤内运行，不占用时间。去掉 'internal' 以便稍后通过外部队列投递，或去掉"
" 'delay' 以立即执行。"

#: statemachine/event.py:108
#, python-brace-format
msgid ""
"Event() received a non-string 'id' ({cls_name}). To combine multiple "
"transitions under one event, use the | operator: t1 | t2."
msgstr "Event() 接收到的 'id' 不是字符串 ({cls_name})。要将多个转换组合在同一个事件下，请使用 | 运算符：t1 | t2。"

#: statemachine/event.py:147
#, python-brace-format
msgid "Cannot add callback '{}' to an event with no transitions."
msgstr "无法将回调 '{}' 添加到没有转换的事件。"

#: statemachine/event.py:182
#, python-brace-format
msgid "Event {} cannot be called without a SM instance"
msgstr "事件 {} 不能在没有 SM 实例的情况下调用"

#: statemachine/exceptions.py:25
#, python-brace-format
msgid "{!r} is not a valid state value."
msgstr "{!r} 不是有效的状态值。"

#: statemachine/exceptions.py:40
#, python-brace-format
msgid "Can't {} when in {}."
msgstr "在 {} 时无法 {}。"

#: statemachine/factory.py:91
#, python-brace-format
msgid ""
"There should be one and only one initial state. Your currently have "
"these: {0}"
msgstr "应有且仅有一个初始状态。当前您有这些：{0}"

#: statemachine/factory.py:249
#, python-brace-format
msgid "is declared in both the '{}' and the '{}' state bodies"
msgstr "同时声明在 '{}' 和 '{}' 状态体中"

#: statemachine/factory.py:253
#, python-brace-format
msgid "in the '{}' state body clashes with the event '{}'"
msgstr "在 '{}' 状态体中与事件 '{}' 冲突"

#: statemachine/factory.py:257
#, python-brace-format
msgid "is declared in both the '{}' state body and the '{}' class body"
msgstr "同时声明在 '{}' 状态体和 '{}' 类体中"

#: statemachine/factory.py:261
#, python-brace-format
msgid "in the '{}' state body clashes with the '{}' attribute of '{}'"
msgstr "在 '{0}' 状态体中与 '{2}' 的属性 '{1}' 冲突"

#: statemachine/factory.py:267
#, python-brace-format
msgid ""
"Callback '{}' {}. Nested state bodies share the class namespace. Rename "
"one of them."
msgstr "回调 '{}' {}。嵌套状态体共享类的命名空间。请重命名其中一个。"

#: statemachine/factory.py:291
#, python-brace-format
msgid ""
"There should be one and only one initial state. You currently have these:"
" {!r}"
msgstr "应有且仅有一个初始状态。当前您有这些：{!r}"

#: statemachine/factory.py:306
#, python-brace-format
msgid "Cannot declare transitions from final state. Invalid state(s): {}"
msgstr "无法从终止状态声明转换。无效状态：{}"

#: statemachine/factory.py:318
#, python-brace-format
msgid ""
"All non-final states should have at least one outgoing transition. These "
"states have no outgoing transition: {!r}"
msgstr "所有非终止状态都应至少有一个外部转换。这些状态没有外部转换：{!r}"

#: statemachine/factory.py:332
#, python-brace-format
msgid ""
"All non-final states should have at least one path to a final state. "
"These states have no path to a final state: {!r}"
msgstr "所有非终止状态应至少有一个到终止状态的路径。这些状态没有到终止状态的路径：{!r}"

#: statemachine/factory.py:345
#, python-brace-format
msgid ""
"There are unreachable states. The statemachine graph should have a single"
" component. Disconnected states: {}"
msgstr "存在不可到达的状态。状态机图应具有单个组件。断开的状态：{}"

#: statemachine/factory.py:382
#, python-brace-format
msgid ""
"Invalid entry in 'listeners': {!r}. Expected a class, callable, or "
"listener instance."
msgstr "'listeners' 中的条目无效：{!r}。期望为类、可调用对象或监听器实例。"

#: statemachine/factory.py:481
#, python-brace-format
msgid "An event in the '{}' has no id."
msgstr "'{}' 中的事件没有 ID。"

#: statemachine/mixins.py:28
#, python-brace-format
msgid "{!r} is not a valid state machine name."
msgstr "{!r} 不是有效的状态机名称。"

#: statemachine/state.py:273
msgid "'donedata' can only be specified on final states."
msgstr "'donedata' 只能在终止状态上指定。"

#: statemachine/statemachine.py:168
msgid "There are no states or transitions."
msgstr "没有状态或转换。"

#: statemachine/statemachine.py:242
#, python-brace-format
msgid "State overriding is not allowed. Trying to add '{}' to {}"
msgstr "不允许覆盖状态。尝试将 '{}' 添加到 {}"

#: statemachine/transition.py:74
#, python-brace-format
msgid ""
"Not a valid internal transition from source {source!r}, target {target!r}"
" should be self or a descendant."
msgstr "从源 {source!r} 的内部转换无效，目标 {target!r} 应为自身或后代。"

#: statemachine/transition_mixin.py:19
#, python-brace-format
msgid "{} only supports the decorator syntax to register callbacks."
msgstr "{} 仅支持使用装饰器语法注册回调。"

#: statemachine/engines/async_.py:50
msgid ""
"The task running the processing loop was cancelled while it processed "
"this event."
msgstr "运行处理循环的任务在处理此事件时被取消。"

#~ msgid "There are no states."
#~ msgstr "没有状态。"

#~ msgid "There are no events."
#~ msgstr "没有事件。"

#~ msgid "Only RTC is supported on async engine"
#~ msgstr "异步引擎仅支持 RTC"
